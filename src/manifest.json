{
  "manifest_version": 3,
  "name": "AssistAnt",
  "version": "0.1.0",
  "description": "Toolbar AI assistant that uses your own API key.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "nativeMessaging",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "action": {
    "default_title": "AssistAnt",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-16.png",
      "19": "icons/toolbar-19.png",
      "32": "icons/toolbar-32.png",
      "38": "icons/toolbar-38.png",
      "48": "icons/toolbar-48.png",
      "64": "icons/toolbar-64.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  }
}
