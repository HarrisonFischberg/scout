{
  "name": "assist-ant",
  "version": "0.1.0",
  "private": true,
  "description": "AssistAnt Safari extension (TypeScript, bundled with esbuild)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "ASSISTANT_BUILD=release node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.lint.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:release": "bash scripts/check-release-bundle.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarrisonFischberg/assist-ant.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
