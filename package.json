{
  "name": "scout-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Scout AI Assistant browser extension for Safari, Chrome and Firefox (TypeScript, bundled with esbuild)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "SCOUT_BUILD=release node scripts/build.mjs",
    "build:chrome": "SCOUT_TARGET=chrome SCOUT_BUILD=release node scripts/build.mjs",
    "build:firefox": "SCOUT_TARGET=firefox SCOUT_BUILD=release node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.lint.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:release": "bash scripts/check-release-bundle.sh",
    "check:rename": "bash scripts/check-rename.sh",
    "check:screenshots": "node scripts/check-store-screenshots.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarrisonFischberg/scout-ai-assistant.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
